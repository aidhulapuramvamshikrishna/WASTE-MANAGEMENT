# OPTIONAL. The app runs locally with these defaults and needs NO .env file.
# Only copy to .env if you want to change something on your machine. Never commit .env.
ENV=development

# --- backend ---
MODEL_DIR=../ml/artifacts
DEFAULT_MODEL=mobilenet_v3
DATABASE_URL=sqlite:///./storage/ecosort.db
STORAGE_DIR=./storage
MAX_UPLOAD_MB=8
RATE_LIMIT_PREDICT=20/minute
ALLOWED_ORIGINS=http://localhost:3000
# Leave empty locally: a random admin token is generated at startup and printed in the terminal.
ADMIN_TOKEN=
TORCH_DEVICE=auto

# --- frontend ---
BACKEND_URL=http://localhost:8000

# --- ml ---
WASTE_DATA_DIR=../data/processed/waste12
